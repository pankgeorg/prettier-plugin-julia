{
  "name": "prettier-plugin-julia",
  "version": "0.2.0",
  "private": true,
  "description": "Prettier plugin for Julia, using Julia's own parser (JuliaSyntax) compiled to WebAssembly; every format is checked to keep the program's meaning",
  "keywords": [
    "prettier",
    "prettier-plugin",
    "julia",
    "julialang",
    "formatter",
    "code-formatter",
    "juliasyntax",
    "webassembly"
  ],
  "homepage": "https://github.com/pankgeorg/prettier-plugin-julia#readme",
  "bugs": {
    "url": "https://github.com/pankgeorg/prettier-plugin-julia/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pankgeorg/prettier-plugin-julia.git"
  },
  "license": "MIT",
  "author": "Panagiotis Georgakopoulos",
  "type": "module",
  "engines": {
    "node": "^22.23.3 || ^24.22.1"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "wasm/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node scripts/check-artifact.mjs && node --test tests/*.test.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:julia": "prettier --ignore-path .gitignore --check \"tests/format/*.out.jl\"",
    "smoke": "node scripts/smoke.mjs",
    "corpus": "node scripts/corpus.mjs",
    "corpus:summary": "node scripts/corpus-summary.mjs"
  },
  "peerDependencies": {
    "prettier": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-n": "^18.5.0",
    "globals": "^17.14.0",
    "prettier": "3.9.10"
  }
}
